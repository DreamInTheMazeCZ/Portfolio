{
  "mcpServers": {
    "_comment": "PostgreSQL 설정 방법",
    "postgres": {
      "command": "npx",
      "args": ["-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://{USER}:{PASSWORD}@{HOST}:{PORT}/{DATABASE}"
      ],
      "env": {
        "PGHOST": "HOST",
        "PGPORT": "PORT",
        "PGUSER": "USER",
        "PGPASSWORD": "PASSWORD",
        "PGDATABASE": "DATABASE"
      }
    }
  }
}
